{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}

<style>

  
</style>

{% assign albums = section.settings.albums %}
{% assign valid_albums_count = 0 %}

{% for album in albums %}
  {% if album != blank and album.title.value != blank and album.album_key.value != blank %}
    {% assign valid_albums_count = valid_albums_count | plus: 1 %}
  {% endif %}
{% endfor %}

<section class="media-gallery-section" id="media-gallery-{{ section.id }}">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="media-gallery-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if albums != blank and valid_albums_count > 0 %}
      <div class="media-gallery-layout">
        <div class="media-gallery-left">
          {% assign rendered_index = 0 %}
          {% for album in albums %}
            {% if album != blank and album.title.value != blank and album.album_key.value != blank %}
              {% assign rendered_index = rendered_index | plus: 1 %}
              {% if rendered_index == 1 %}
                <button
                  type="button"
                  class="media-album-card"
                  data-album-open="{{ album.album_key.value | escape }}"
                  aria-label="Open album {{ album.title.value | escape }}"
                >
                  {% if album.thumbnail.value != blank %}
                    {{
                      album.thumbnail.value
                      | image_url: width: 1400
                      | image_tag:
                        class: 'media-album-card__image',
                        loading: 'lazy',
                        widths: '400, 700, 900, 1200, 1400',
                        alt: album.title.value
                    }}
                  {% else %}
                    <div class="media-album-card__placeholder"></div>
                  {% endif %}

                  <div class="media-album-card__content">
                    <h3 class="media-album-card__title">{{ album.title.value }}</h3>
                    {% if album.creation_date.value != blank %}
                      <p class="media-album-card__date">
                        {{ album.creation_date.value | date: '%B %d, %Y' }}
                      </p>
                    {% endif %}
                  </div>
                </button>
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        <div class="media-gallery-right">
          {% assign rendered_index = 0 %}
          {% for album in albums %}
            {% if album != blank and album.title.value != blank and album.album_key.value != blank %}
              {% assign rendered_index = rendered_index | plus: 1 %}
              {% if rendered_index == 2 or rendered_index == 3 %}
                <button
                  type="button"
                  class="media-album-card"
                  data-album-open="{{ album.album_key.value | escape }}"
                  aria-label="Open album {{ album.title.value | escape }}"
                >
                  {% if album.thumbnail.value != blank %}
                    {{
                      album.thumbnail.value
                      | image_url: width: 1000
                      | image_tag:
                        class: 'media-album-card__image',
                        loading: 'lazy',
                        widths: '300, 500, 700, 900, 1000',
                        alt: album.title.value
                    }}
                  {% else %}
                    <div class="media-album-card__placeholder"></div>
                  {% endif %}

                  <div class="media-album-card__content">
                    <h3 class="media-album-card__title">{{ album.title.value }}</h3>
                    {% if album.creation_date.value != blank %}
                      <p class="media-album-card__date">
                        {{ album.creation_date.value | date: '%B %d, %Y' }}
                      </p>
                    {% endif %}
                  </div>
                </button>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_all_albums and valid_albums_count > 3 %}
        <div class="media-gallery-rest">
          {% assign rendered_index = 0 %}
          {% for album in albums %}
            {% if album != blank and album.title.value != blank and album.album_key.value != blank %}
              {% assign rendered_index = rendered_index | plus: 1 %}
              {% if rendered_index > 3 %}
                <button
                  type="button"
                  class="media-album-card"
                  data-album-open="{{ album.album_key.value | escape }}"
                  aria-label="Open album {{ album.title.value | escape }}"
                >
                  {% if album.thumbnail.value != blank %}
                    {{
                      album.thumbnail.value
                      | image_url: width: 1000
                      | image_tag:
                        class: 'media-album-card__image',
                        loading: 'lazy',
                        widths: '300, 500, 700, 900, 1000',
                        alt: album.title.value
                    }}
                  {% else %}
                    <div class="media-album-card__placeholder"></div>
                  {% endif %}

                  <div class="media-album-card__content">
                    <h3 class="media-album-card__title">{{ album.title.value }}</h3>
                    {% if album.creation_date.value != blank %}
                      <p class="media-album-card__date">
                        {{ album.creation_date.value | date: '%B %d, %Y' }}
                      </p>
                    {% endif %}
                  </div>
                </button>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% unless section.settings.show_all_albums %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <div class="media-gallery-button-wrap">
            <a href="{{ section.settings.button_link }}" class="media-gallery-button">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      {% endunless %}
    {% endif %}
  </div>

  {% if albums != blank and valid_albums_count > 0 %}
    {% for album in albums %}
      {% if album != blank and album.title.value != blank and album.album_key.value != blank %}
        {% assign current_album_key = album.album_key.value %}
        {% assign gallery_images = album.gallery_images.value %}

        <div class="media-album-modal" data-album-modal="{{ current_album_key | escape }}" aria-hidden="true">
          <div class="media-album-modal__overlay" data-album-close></div>

          <div class="media-album-modal__dialog" role="dialog" aria-modal="true" aria-label="{{ album.title.value | escape }}">
            <div class="media-album-modal__header">
              <div>
                <h3 class="media-album-modal__title">{{ album.title.value }}</h3>
                {% if album.creation_date.value != blank %}
                  <p class="media-album-modal__date">
                    {{ album.creation_date.value | date: '%B %d, %Y' }}
                  </p>
                {% endif %}
              </div>

              <button type="button" class="media-album-modal__close" data-album-close aria-label="Close popup">
                &times;
              </button>
            </div>

            <div class="media-album-modal__body">
              <div class="swiper media-album-swiper" data-swiper="{{ current_album_key | escape }}">
                <div class="swiper-wrapper">
                  {% if gallery_images != blank %}
                    {% for media_image in gallery_images %}
                      <div class="swiper-slide">
                        <div class="media-album-swiper__image-wrap">
                          {{
                            media_image
                            | image_url: width: 1800
                            | image_tag:
                              loading: 'lazy',
                              widths: '400, 700, 900, 1200, 1500, 1800',
                              alt: album.title.value
                          }}
                        </div>
                      </div>
                    {% endfor %}
                  {% elsif album.thumbnail.value != blank %}
                    <div class="swiper-slide">
                      <div class="media-album-swiper__image-wrap">
                        {{
                          album.thumbnail.value
                          | image_url: width: 1400
                          | image_tag:
                            loading: 'lazy',
                            widths: '400, 700, 900, 1200, 1400',
                            alt: album.title.value
                        }}
                      </div>
                    </div>
                  {% endif %}
                </div>

                <div class="swiper-pagination"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.getElementById('media-gallery-{{ section.id }}');
    if (!section) return;

    const openButtons = section.querySelectorAll('[data-album-open]');
    const modals = section.querySelectorAll('[data-album-modal]');
    const swiperInstances = {};

    function initSwiper(key) {
      if (swiperInstances[key]) return swiperInstances[key];

      const container = section.querySelector('[data-swiper="' + CSS.escape(key) + '"]');
      if (!container || typeof Swiper === 'undefined') return null;

      swiperInstances[key] = new Swiper(container, {
        slidesPerView: 1,
        spaceBetween: 16,
        loop: false,
        autoHeight: true,
        pagination: {
          el: container.querySelector('.swiper-pagination'),
          clickable: true
        },
        navigation: {
          nextEl: container.querySelector('.swiper-button-next'),
          prevEl: container.querySelector('.swiper-button-prev')
        },
        keyboard: {
          enabled: true
        }
      });

      return swiperInstances[key];
    }

    function openModal(key) {
      const modal = section.querySelector('[data-album-modal="' + CSS.escape(key) + '"]');
      if (!modal) return;

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('media-gallery-modal-open');

      const swiper = initSwiper(key);
      if (swiper) {
        setTimeout(function () {
          swiper.update();
        }, 60);
      }
    }

    function closeModal(modal) {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');

      if (!section.querySelector('.media-album-modal.is-open')) {
        document.body.classList.remove('media-gallery-modal-open');
      }
    }

    openButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        openModal(button.getAttribute('data-album-open'));
      });
    });

    modals.forEach(function (modal) {
      modal.querySelectorAll('[data-album-close]').forEach(function (button) {
        button.addEventListener('click', function () {
          closeModal(modal);
        });
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;

      modals.forEach(function (modal) {
        if (modal.classList.contains('is-open')) {
          closeModal(modal);
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Media gallery albums",
  "tag": "section",
  "class": "section-media-gallery-albums",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Media Gallery"
    },
    {
      "type": "metaobject_list",
      "id": "albums",
      "label": "Albums",
      "metaobject_type": "album_block",
      "limit": 50
    },
    {
      "type": "checkbox",
      "id": "show_all_albums",
      "label": "Show all selected albums",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Visit our media gallery"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Media gallery albums"
    }
  ]
}
{% endschema %}